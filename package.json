{
  "name": "dsh-ding-chime",
  "version": "1.0.0",
  "description": "Play a sound when a DeepSeek Harness turn finishes, needs your reply, or fails. Ships with preset chimes and a settings page.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "cordis",
    "notification",
    "sound",
    "audio",
    "alert",
    "chime",
    "windows"
  ],
  "homepage": "https://github.com/Programmer-MrWang/dsh-ding#readme",
  "bugs": {
    "url": "https://github.com/Programmer-MrWang/dsh-ding/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Programmer-MrWang/dsh-ding.git"
  },
  "author": "Wang Haoyu (Programmer-MrWang)",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "scripts": {
    "test": "node --test test/plugin.test.mjs test/client-render.test.mjs test/routes.test.mjs",
    "check": "node --check lib/index.js && node --check lib/client.js && node scripts/build-client.mjs --check && node scripts/check-identity.mjs",
    "build": "node scripts/build-client.mjs",
    "gen:sounds": "python scripts/generate-sounds.py"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
